# ============================================================
# Brochures — variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================

# --- Servidor ---
# Puerto en el que escucha Express (Railway lo inyecta automáticamente)
# PORT=3000

# --- Panel de administración ---
# Contraseña para acceder a /admin.html y a los endpoints /api/admin/*
# Elige una cadena larga y aleatoria.
ADMIN_PASSWORD=cambia_esta_clave

# --- Backup en Dropbox ---
# Credenciales de la app Dropbox (obtenidas en https://www.dropbox.com/developers/apps)
# Usar siempre Refresh Token — nunca un Access Token estático.
#
# Cómo obtener el Refresh Token (flujo offline):
#   1. En el App Console de Dropbox, habilita el scope "files.content.write"
#   2. Genera un token de larga duración con grant_type=offline
#      (misma mecánica que en PRIOCOHORT-CI)
#
DROPBOX_REFRESH_TOKEN=your_refresh_token_here
DROPBOX_APP_KEY=your_app_key_here
DROPBOX_APP_SECRET=your_app_secret_here

# Ruta dentro de Dropbox donde se depositan los backups.
# El servidor añade el nombre de archivo con timestamp: portadores_YYYY-MM-DD_HH-mm.csv
DROPBOX_BACKUP_PATH=/ConnectingPrion/PSPS/Databases

# --- Correo electrónico (Nodemailer / SMTP) ---
# Servidor SMTP saliente. Usa las credenciales del hosting o cuenta de correo.
SMTP_HOST=mail.joaquincastilla.com

# Puerto SMTP. 587 = STARTTLS (recomendado), 465 = SSL/TLS implícito, 25 = sin cifrado.
SMTP_PORT=587

# true  → conexión SSL/TLS directa (puerto 465)
# false → STARTTLS o sin cifrado (puertos 587 / 25)
SMTP_SECURE=false

# Cuenta SMTP desde la que se enviarán todos los correos.
SMTP_USER=castilla@joaquincastilla.com

# Contraseña de la cuenta SMTP. Nunca la subas al repositorio.
SMTP_PASS=tu_contraseña_smtp_aqui

# Dirección interna que recibirá las notificaciones cuando un portador confirme su participación.
# Normalmente coincide con SMTP_USER.
CONTACT_EMAIL=castilla@joaquincastilla.com

# --- Tokens de baja de píldoras ---
# Clave secreta usada para generar los tokens HMAC en los enlaces de desuscripción del email.
# Elige una cadena larga y aleatoria. Cámbiala solo si quieres invalidar todos los tokens existentes.
UNSUB_SECRET=cambia_esta_clave_secreta_de_baja
